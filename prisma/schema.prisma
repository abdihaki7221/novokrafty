generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Admin")
  avatar    String?
  createdAt DateTime @default(now())
}

model SiteVisit {
  id        String   @id @default(cuid())
  page      String
  referrer  String?
  userAgent String?
  ip        String?
  country   String?
  createdAt DateTime @default(now())
}

model DemoClick {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referrer  String?
  createdAt DateTime @default(now())
}

model Project {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  category    String
  description String
  longDesc    String?
  image       String?
  demoUrl     String?
  videoUrl    String?
  techStack   String[]
  featured    Boolean     @default(false)
  published   Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  demoClicks  DemoClick[]
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  icon        String
  description String
  features    String[]
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  image     String?
  linkedin  String?
  twitter   String?
  github    String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  website   String?
  tier      String   @default("partner") // partner, gold, platinum
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Career {
  id          String   @id @default(cuid())
  title       String
  department  String
  type        String   // Full-time, Part-time, Contract, Internship
  location    String
  description String
  requirements String[]
  salary      String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String?
  text      String
  image     String?
  rating    Int      @default(5)
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id          String   @id @default("main")
  companyName String   @default("Novokraft Limited")
  tagline     String   @default("Engineering the Future")
  email       String   @default("hello@novokraft.com")
  phone       String   @default("+254 707 332 229")
  address     String   @default("Nairobi, Kenya")
  mission     String   @default("")
  vision      String   @default("")
  values      String[]

  // Social links (optional - shown only if set & enabled)
  linkedin    String?
  twitter     String?
  github      String?
  youtube     String?
  showSocials Boolean  @default(false)

  // WhatsApp contact
  whatsappNumber  String?  @default("+254707332229")
  whatsappMessage String?  @default("Hi Novokraft, I'd like to discuss a project.")

  // ── HERO SECTION ──
  heroBadge        String  @default("Pioneering Digital Transformation Across Africa")
  heroTitleLine1   String  @default("We Architect")
  heroTitleLine2   String  @default("Software That")
  heroTitleHighlight String @default("Moves Needles")
  heroSubtitle     String  @default("From fintech infrastructure to AI-powered agents, we engineer the systems that power East Africa's most ambitious companies.")
  heroCtaPrimary   String  @default("Start Your Project")
  heroCtaSecondary String  @default("View Our Work")
  techStack        String[]

  // ── STATS ──
  stat1Value String @default("120+")
  stat1Label String @default("Projects Delivered")
  stat2Value String @default("45+")
  stat2Label String @default("Active Clients")
  stat3Value String @default("30+")
  stat3Label String @default("Team Members")
  stat4Value String @default("99.9%")
  stat4Label String @default("Uptime SLA")

  // ── SECTION HEADINGS (home) ──
  servicesSubtitle String @default("Capabilities")
  servicesTitle    String @default("Full-Spectrum Software Engineering")
  servicesDesc     String @default("We don't just write code. We architect systems that scale, delight users, and drive measurable business outcomes.")
  projectsSubtitle String @default("Portfolio")
  projectsTitle    String @default("Projects That Speak Volumes")
  projectsDesc     String @default("Real solutions, shipped to production, driving results for real businesses.")
  testimonialsSubtitle String @default("Testimonials")
  testimonialsTitle    String @default("Trusted by Ambitious Companies")

  // ── CTA BLOCK (home) ──
  ctaTitle    String @default("Ready to Build Something Extraordinary?")
  ctaDesc     String @default("Let's turn your vision into production-grade reality. Tell us about your project.")
  ctaButton   String @default("Get In Touch")

  // ── CONTACT PAGE ──
  contactSubtitle String @default("Contact")
  contactTitle    String @default("Let's Start a Conversation")
  contactDesc     String @default("Tell us about your project and we'll get back to you immediately.")
  contactMode     String @default("whatsapp") // "whatsapp" or "form"
  contactLocation String @default("Westlands, Nairobi, Kenya")
  contactLocationSub String @default("East Africa")
  contactHoursValue String @default("Monday — Friday")
  contactHoursSub   String @default("8:00 AM — 6:00 PM EAT")
  contactEmailSub   String @default("We reply immediately")
  contactPhoneSub   String @default("Mon–Fri, 8AM–6PM")

  // ── ABOUT PAGE ──
  aboutSubtitle String @default("About Novokraft")
  aboutTitle    String @default("The Story Behind the Code")
  aboutDesc     String @default("We're not just developers. We're craftspeople obsessed with building software that transforms how businesses operate.")

  // ── FOOTER ──
  footerTagline String @default("Engineering the digital backbone of tomorrow's enterprises. From Nairobi to the world.")
  footerCopyright String @default("Novokraft Limited. All rights reserved.")

  updatedAt   DateTime @updatedAt
}
